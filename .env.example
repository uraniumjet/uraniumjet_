# Copy to .env for local use (export the values, or use your shell's env loader). Never commit real keys.
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
SITE_URL=http://127.0.0.1:5000

# Where contact-form messages go
MAIL_TO=uraniumjetdigitalsolution@gmail.com

# MAIL_BACKEND=console prints messages to the terminal (default when FLASK_DEBUG=1)
# MAIL_BACKEND=resend    needs RESEND_API_KEY and MAIL_FROM
# MAIL_BACKEND=smtp      needs SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, MAIL_FROM
MAIL_BACKEND=console
RESEND_API_KEY=
MAIL_FROM=

# Optional override of the WhatsApp number (international format, digits only)
# WHATSAPP_NUMBER=2349034097508
