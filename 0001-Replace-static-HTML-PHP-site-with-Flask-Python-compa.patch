diff --git a/templates/base.html b/templates/base.html
new file mode 100644
index 0000000..32125b5
--- /dev/null
+++ b/templates/base.html
@@ -0,0 +1,90 @@
+{% import "_macros.html" as m with context %}<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>{% block title %}{{ site.name }} | {{ site.tagline }}{% endblock %}</title>
+  <meta name="description" content="{% block description %}{{ site.description }}{% endblock %}">
+  <meta name="theme-color" content="#101A2E">
+  {% block canonical %}<link rel="canonical" href="{{ absolute(current_endpoint) }}">{% endblock %}
+  <meta property="og:type" content="website">
+  <meta property="og:site_name" content="{{ site.name }}">
+  <meta property="og:title" content="{{ self.title() }}">
+  <meta property="og:description" content="{{ self.description() }}">
+  <meta property="og:image" content="{{ absolute('static', filename='img/og.png') }}">
+  <meta name="twitter:card" content="summary_large_image">
+  <link rel="icon" href="{{ asset('img/favicon.svg') }}" type="image/svg+xml">
+  <link rel="stylesheet" href="{{ asset('css/site.css') }}">
+  <script type="application/ld+json">{{ {
+    "@context": "https://schema.org",
+    "@type": "Organization",
+    "name": site.name,
+    "url": absolute('home'),
+    "email": site.email,
+    "telephone": site.phones[0].intl,
+    "address": {"@type": "PostalAddress", "streetAddress": site.address_lines[0] ~ ", " ~ site.address_lines[1], "addressLocality": "Kano", "addressCountry": "NG"}
+  } | tojson }}</script>
+</head>
+<body>
+  <a class="skip" href="#main">Skip to content</a>
+
+  <header class="site-header">
+    <div class="wrap bar">
+      <a class="brand" href="{{ url_for('home') }}" aria-label="{{ site.name }}, home">
+        {{ m.logo() }}
+        <span class="brand-text"><span class="brand-name">{{ site.short }}</span><span class="brand-sub">Digital Solution</span></span>
+      </a>
+      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">Menu</button>
+      <nav id="primary-nav" class="nav" aria-label="Main">
+        <ul>
+          {% for key, label in nav %}
+          <li><a href="{{ url_for(key) }}"{% if current_endpoint == key or (key == 'products' and current_endpoint == 'product_hostel') %} aria-current="page"{% endif %}>{{ label }}</a></li>
+          {% endfor %}
+        </ul>
+        <a class="btn btn--ink btn--sm" href="{{ url_for('contact') }}">Talk to us</a>
+      </nav>
+    </div>
+  </header>
+
+  <main id="main">
+    {% block content %}{% endblock %}
+  </main>
+
+  <footer class="site-footer">
+    <div class="wrap footer-grid">
+      <div>
+        <a class="brand brand--light" href="{{ url_for('home') }}" aria-label="{{ site.name }}, home">
+          {{ m.logo() }}
+          <span class="brand-text"><span class="brand-name">{{ site.short }}</span><span class="brand-sub">Digital Solution</span></span>
+        </a>
+        <p class="footer-tag">{{ site.tagline }}</p>
+      </div>
+      <div>
+        <h2 class="footer-h">Explore</h2>
+        <ul class="footer-list">
+          {% for key, label in nav %}<li><a href="{{ url_for(key) }}">{{ label }}</a></li>{% endfor %}
+        </ul>
+      </div>
+      <div>
+        <h2 class="footer-h">Contact</h2>
+        <ul class="footer-list">
+          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
+          {% for p in site.phones %}<li><a href="tel:{{ p.intl }}">{{ p.display }}</a></li>{% endfor %}
+          <li><a href="{{ whatsapp_url() }}" target="_blank" rel="noopener">WhatsApp</a></li>
+          <li class="footer-address">{{ site.address_lines | join(", ") }}</li>
+        </ul>
+      </div>
+    </div>
+    <div class="wrap footer-base">
+      {{ m.color_bar() }}
+      <p>&copy; {{ year }} {{ site.name }}. All rights reserved.</p>
+    </div>
+  </footer>
+
+  <a class="wa-float" href="{{ whatsapp_url() }}" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
+    {{ m.wa_icon() }}<span class="wa-float-text">WhatsApp</span>
+  </a>
+
+  <script src="{{ asset('js/site.js') }}" defer></script>
+</body>
+</html>
diff --git a/templates/contact.html b/templates/contact.html
new file mode 100644
index 0000000..11bd64f
--- /dev/null
+++ b/templates/contact.html
@@ -0,0 +1,88 @@
+{% extends "base.html" %}
+{% import "_macros.html" as m with context %}
+{% block title %}Contact | {{ site.name }}{% endblock %}
+{% block description %}Send Uranium Jet Digital Solution a message, chat on WhatsApp, call, or visit us in Kano.{% endblock %}
+{% block content %}
+
+<section class="page-head">
+  <div class="wrap">
+    <h1>Contact</h1>
+    <p class="lead">Send a message, or reach us the way that suits you.</p>
+  </div>
+</section>
+
+<section class="section section--tight">
+  <div class="wrap contact-grid">
+
+    <form class="form" method="post" action="{{ url_for('contact_submit') }}" novalidate>
+      {% if notice or errors %}
+      <div class="alert" role="alert" tabindex="-1" id="form-alert">
+        {% if notice %}{{ notice }}{% else %}Please fix the {{ errors|length }} highlighted field{{ "s" if errors|length > 1 }} and send again.{% endif %}
+      </div>
+      {% endif %}
+
+      <input type="hidden" name="csrf" value="{{ token }}">
+      <div class="hp" aria-hidden="true">
+        <label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
+      </div>
+
+      <div class="field">
+        <label for="name">Your name</label>
+        <input id="name" name="name" type="text" autocomplete="name" maxlength="80" required value="{{ form.name or '' }}"{% if errors.name %} aria-invalid="true" aria-describedby="err-name"{% endif %}>
+        {% if errors.name %}<p class="field-error" id="err-name">{{ errors.name }}</p>{% endif %}
+      </div>
+
+      <div class="field">
+        <label for="email">Email</label>
+        <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required value="{{ form.email or '' }}"{% if errors.email %} aria-invalid="true" aria-describedby="err-email"{% endif %}>
+        {% if errors.email %}<p class="field-error" id="err-email">{{ errors.email }}</p>{% endif %}
+      </div>
+
+      <div class="field">
+        <label for="phone">Phone or WhatsApp number <span class="optional">(optional)</span></label>
+        <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="30" value="{{ form.phone or '' }}"{% if errors.phone %} aria-invalid="true" aria-describedby="err-phone"{% endif %}>
+        {% if errors.phone %}<p class="field-error" id="err-phone">{{ errors.phone }}</p>{% endif %}
+      </div>
+
+      <div class="field">
+        <label for="topic">What do you need help with?</label>
+        <select id="topic" name="topic" required{% if errors.topic %} aria-invalid="true" aria-describedby="err-topic"{% endif %}>
+          <option value="">Choose one</option>
+          {% for value, label in topics %}
+          <option value="{{ value }}"{% if form.topic == value %} selected{% endif %}>{{ label }}</option>
+          {% endfor %}
+        </select>
+        {% if errors.topic %}<p class="field-error" id="err-topic">{{ errors.topic }}</p>{% endif %}
+      </div>
+
+      <div class="field">
+        <label for="message">Your message</label>
+        <textarea id="message" name="message" rows="6" maxlength="3000" required{% if errors.message %} aria-invalid="true" aria-describedby="err-message"{% endif %}>{{ form.message or '' }}</textarea>
+        {% if errors.message %}<p class="field-error" id="err-message">{{ errors.message }}</p>{% endif %}
+      </div>
+
+      <button class="btn btn--primary btn--block" type="submit" data-sending="Sending...">Send message</button>
+      <p class="fineprint">We use your details only to reply to your message. This form sets one cookie to protect it from spam.</p>
+    </form>
+
+    <aside class="contact-side" aria-label="Other ways to reach us">
+      <h2>Prefer to chat?</h2>
+      {{ m.wa_button(extra="btn--block") }}
+
+      <h2>Call or email</h2>
+      <ul class="plain">
+        {% for p in site.phones %}<li><a href="tel:{{ p.intl }}">{{ p.display }}</a></li>{% endfor %}
+        <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
+      </ul>
+
+      <h2>Visit us</h2>
+      <address class="plain">
+        {% for line in site.address_lines %}{{ line }}<br>{% endfor %}
+      </address>
+      <p><a class="text-link" href="https://www.google.com/maps/search/?api=1&amp;query={{ site.address_lines | join(', ') | urlencode }}" target="_blank" rel="noopener">Open in Google Maps</a></p>
+    </aside>
+
+  </div>
+</section>
+
+{% endblock %}
