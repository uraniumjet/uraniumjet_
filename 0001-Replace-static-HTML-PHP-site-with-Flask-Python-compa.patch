+{% extends "base.html" %}
+{% import "_macros.html" as m with context %}
+{% block content %}
+
+<section class="hero">
+  <div class="wrap hero-grid">
+    <div class="hero-copy">
+      <h1>Practical software and IT support, built in Kano.</h1>
+      <p class="lead">We build management systems for hostels, schools and shops, and we still run the print and cyber café counter where we started. Try our hostel meals system in your browser, or message us on WhatsApp.</p>
+      <div class="actions">
+        <a class="btn btn--primary" href="{{ site.demo_url }}" target="_blank" rel="noopener">Try the live demo</a>
+        {{ m.wa_button() }}
+      </div>
+      <p class="fineprint">The demo uses sample data and can take about a minute to wake up the first time you open it.</p>
+    </div>
+    <div class="hero-visual">
+      {% include "_proof.html" %}
+    </div>
+  </div>
+</section>
+
+<section class="section" aria-labelledby="what-we-do">
+  <div class="wrap">
+    <h2 id="what-we-do" class="section-title">What we do</h2>
+    <ul class="rows">
+      {% for g in groups %}
+      <li class="row">
+        <h3 class="row-title">{{ g.title }}</h3>
+        <p class="row-text">{{ g.summary }}</p>
+        <a class="row-link" href="{{ url_for('services') }}#{{ g.id }}">See details<span class="sr-only"> for {{ g.title }}</span></a>
+      </li>
+      {% endfor %}
+    </ul>
+  </div>
+</section>
+
+<section class="panel" aria-labelledby="product-title">
+  <div class="wrap panel-grid">
+    <div>
+      <h2 id="product-title" class="panel-title">{{ hostel.name }}: {{ hostel.headline|lower }}</h2>
+      <p class="panel-lead">{{ hostel.summary }}</p>
+      <div class="actions">
+        <a class="btn btn--yellow" href="{{ site.demo_url }}" target="_blank" rel="noopener">Try the live demo</a>
+        <a class="btn btn--outline-light" href="{{ url_for('product_hostel') }}">Read how it works</a>
+      </div>
+      <p class="panel-note">{% if site.demo_hint %}{{ site.demo_hint }} {% endif %}Sample data only. The first load can take about a minute.</p>
+    </div>
+    <ul class="ticks">
+      {% for f in hostel.features[:4] %}
+      <li><strong>{{ f.title }}</strong><span>{{ f.text }}</span></li>
+      {% endfor %}
+    </ul>
+  </div>
+</section>
+
+<section class="section" aria-labelledby="how-title">
+  <div class="wrap">
+    <h2 id="how-title" class="section-title">How a project runs</h2>
+    <ol class="steps">
+      {% for s in process %}
+      <li class="step step--{{ loop.index }}">
+        <span class="step-n" aria-hidden="true">{{ loop.index }}</span>
+        <h3>{{ s.title }}</h3>
+        <p>{{ s.short }}</p>
+      </li>
+      {% endfor %}
+    </ol>
+    <p class="more"><a class="text-link" href="{{ url_for('how_we_work') }}">See what we need from you at each step</a></p>
+  </div>
+</section>
+
+<section class="section section--wash" aria-labelledby="team-title">
+  <div class="wrap">
+    <h2 id="team-title" class="section-title">The people you will deal with</h2>
+    <ul class="people">
+      {% for p in team %}
+      <li class="person">
+        <img class="portrait" src="{{ asset(p.photo) }}" alt="{{ p.alt }}" width="160" height="160" loading="lazy">
+        <div>
+          <h3>{{ p.name }}</h3>
+          <p class="role">{{ p.role }}</p>
+        </div>
+      </li>
+      {% endfor %}
+    </ul>
+    <p class="more"><a class="text-link" href="{{ url_for('team') }}">About the company and team</a></p>
+  </div>
+</section>
+
+<section class="cta" aria-labelledby="cta-title">
+  <div class="wrap cta-grid">
+    <div>
+      <h2 id="cta-title">Tell us what you need to run better.</h2>
+      <p>A short message is enough to start. We will reply with questions or next steps.</p>
+    </div>
+    <div class="actions">
+      <a class="btn btn--primary" href="{{ url_for('contact') }}">Send a message</a>
+      {{ m.wa_button() }}
+    </div>
+  </div>
+</section>
+
+{% endblock %}
